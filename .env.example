# Game Deal Tracker — secret configuration template.
# Copy this file to ".env" (which is gitignored) and fill in your own values.
# NEVER commit the real .env. These values are read only via src/config.py.

# Discord webhook the bot posts deals to. REQUIRED.
# Create one: Server -> channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=paste_your_webhook_url_here

# IsThereAnyDeal API key (free). REQUIRED.
# Get one at https://isthereanydeal.com -> account -> API.
ITAD_API_KEY=paste_your_itad_key_here

# Your SteamID64. OPTIONAL — enables wishlist alerts.
# Find it at https://steamid.io. Your profile AND wishlist must be public.
STEAM_ID64=

# Steam Web API key (free). OPTIONAL — only used by the watchlist's legacy Steam
# price-check fallback when no ITAD_API_KEY is set; not needed otherwise.
# Get one at https://steamcommunity.com/dev/apikey.
STEAM_API_KEY=
